# Para Supabase (preferencial)
# Use a Connection String do pooler (Session Pooler) para suporte a IPv4:
# DATABASE_URL=postgresql://postgres:senha@aws-0-us-regiao-1.pooler.supabase.com:6543/postgres
#
# Para conexão direta (caso sua rede suporte IPv6):
# DATABASE_URL=postgresql://postgres:senha@db.projetoref.supabase.co:5432/postgres

DATABASE_URL=postgresql://postgres:senha@aws-0-us-west-1.pooler.supabase.com:6543/postgres
GROQ_API_KEY=
OPEN_METEO_URL=https://api.open-meteo.com/v1
ENVIRONMENT=development
