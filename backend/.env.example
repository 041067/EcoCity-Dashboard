# Para Supabase (preferencial)
# Use a Connection String do pooler (Session Pooler) para suporte a IPv4:
# DATABASE_URL=postgresql://postgres:senha@aws-0-us-regiao-1.pooler.supabase.com:6543/postgres
#
# Para conexão direta (caso sua rede suporte IPv6):
# DATABASE_URL=postgresql://postgres:senha@db.projetoref.supabase.co:5432/postgres

DATABASE_URL=postgresql://postgres:senha@aws-0-us-west-1.pooler.supabase.com:6543/postgres
GROQ_API_KEY=
# Guardrails do ESG AI Copilot. Não defina a chave em arquivos versionados ou logs.
GROQ_MODEL=llama-3.1-8b-instant
AI_TIMEOUT_SECONDS=25
AI_MAX_COMPLETION_TOKENS=1400
AI_CONTEXT_MAX_CHARS=14000
AI_RATE_LIMIT_REQUESTS=12
AI_RATE_LIMIT_WINDOW_SECONDS=60
OPEN_METEO_URL=https://api.open-meteo.com/v1
# OpenAQ requer chave própria. INPE e ANEEL possuem defaults oficiais públicos abaixo.
OPENAQ_API_KEY=
OPENAQ_URL=https://api.openaq.org/v3
NASA_POWER_URL=https://power.larc.nasa.gov/api
INPE_FIRE_WFS_URL=https://terrabrasilis.dpi.inpe.br/queimadas/geoserver/ows
INPE_FIRE_LAYER=bdqueimadas2:focos
INPE_DETER_WFS_URL=https://terrabrasilis.dpi.inpe.br/geoserver/deter-amz/wfs
INPE_DETER_LAYER=deter-amz:deter_amz
INPE_ALERT_LOOKBACK_DAYS=7
INPE_ALERT_RADIUS_KM=10
ANEEL_DATASTORE_URL=https://dadosabertos.aneel.gov.br/api/3/action/datastore_search
ANEEL_SIGA_RESOURCE_ID=2f65a1b0-19b8-4360-8238-b34ab4693d55
ANEEL_MAX_RECORDS=5000
ESG_PROVIDER_TIMEOUT_SECONDS=10
ENVIRONMENT=development
